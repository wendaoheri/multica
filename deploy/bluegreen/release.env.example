# Public release metadata only. RELEASE_CONFIG_FILE is the canonical backend
# KEY=VALUE env_file and may contain secrets; keep it root-readable and never
# copy its expanded values into logs or release artifacts.
BLUE_BACKEND_IMAGE=ghcr.io/example/multica-backend@sha256:replace
BLUE_WEB_IMAGE=ghcr.io/example/multica-web@sha256:replace
GREEN_BACKEND_IMAGE=ghcr.io/example/multica-backend@sha256:replace
GREEN_WEB_IMAGE=ghcr.io/example/multica-web@sha256:replace
MIGRATOR_IMAGE=ghcr.io/example/multica-backend@sha256:replace
BLUE_GENERATION=1
GREEN_GENERATION=2
BLUE_WORKER_OWNER=blue-worker-PER-376
GREEN_WORKER_OWNER=green-worker-PER-376
MULTICA_UPLOADS_VOLUME=multica_backend_uploads
MULTICA_STATE_NETWORK=multica_default
RELEASE_ARTIFACT_DIR=/root-only/path/PER-376
RELEASE_EXECUTION_DIR=/root-only/path/PER-376-execution
RELEASE_CONFIG_FILE=/root-only/path/PER-376-config/backend.env
RELEASE_FEATURE_FLAGS_FILE=/root-only/path/PER-376-config/feature-flags.yaml
TARGET_COMBINATION=W1K1S1
# Required during smoke/cutover. The migrator atomically replaces current
# attempt before verification/migration, then completes that exact nonce.
RUNTIME_IDENTITY_COMMAND=/opt/multica/release/runtime_identity.sh
MIGRATOR_CURRENT_ATTEMPT=/root-only/path/PER-376-execution/current-attempt.json
MIGRATOR_EXECUTION_RECORD=/root-only/path/PER-376-execution/migrator-execution.json
OBSERVATION_COMMAND=/opt/multica/release/collect-and-observe-one-window.sh
# Production defaults are hard-gated to at least 3600 seconds.
OBSERVATION_DURATION_SECONDS=3600
OBSERVATION_INTERVAL_SECONDS=60
# The relay values, DATABASE_URL, and REDIS_URL live in RELEASE_CONFIG_FILE;
# Compose consumes that exact file and release validation compares its expanded
# environment without printing values. Deployment-controlled role/owner/token
# keys must remain in this public release input, not the canonical backend file.
