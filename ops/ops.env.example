# MULTICA_OPS_* 配置模板（单一事实来源）
# 依据：PER-267 合成终稿 v1.0 §2 配置管理。
#
# 使用方法：
#   1. 复制本文件：Mac 侧 -> ops/ops.env；服务器侧 -> /opt/multica-ops/ops.env
#   2. 为每个键填写本机环境的值；两侧均保持全量键集合（各脚本只校验并消费自己
#      的子集），日常巡检会核对两侧 ops.env 与本模板的键集合，漂移即 P2。
#   3. 真实 ops.env 一律 mode 600，且绝不提交仓库、不进 NAS、不进备份包。
#
# 硬性规则：
#   - 所有键必填（脚本对各自子集 fail fast 校验，缺失/为空/非法即 exit 1）。
#   - 本文件及 ops.env 严禁写入任何凭据（密码/密钥/令牌）；凭据只在服务器
#     /opt/multica-src/.env（compose 配置，不迁入本约定）。
#   - 路径类值必须为绝对路径；保留份数必须为正整数。
#   - MULTICA_IMAGE_TAG / POSTGRES_PASSWORD 属 compose 配置，不在此处。

# ---------- SSH 通道（Mac -> 服务器） ----------
# Mac 侧脚本连接服务器的 SSH 目标。WireGuard 切换完成后，此值改为隧道内地址。
MULTICA_OPS_SSH_HOST=
# SSH 端口（当前 22；入口切换阶段由配置变更，脚本不硬编码）。
MULTICA_OPS_SSH_PORT=

# ---------- PostgreSQL（容器内） ----------
# 服务器侧备份与 Mac 侧拉取/验证共用。
MULTICA_OPS_PG_CONTAINER=
MULTICA_OPS_PG_USER=
MULTICA_OPS_PG_DB=

# ---------- 服务器侧部署与备份 ----------
# 部署目录（.env 与 docker-compose.selfhost.yml 所在）。
MULTICA_OPS_COMPOSE_DIR=
# uploads 卷宿主路径（Mac 侧流式 tar 拉取用）。
MULTICA_OPS_UPLOADS_DIR=
# 服务器每日例行备份根目录（权威源，cron 03:07）。
MULTICA_OPS_SERVER_BACKUP_ROOT=
# 服务器备份保留天数。
MULTICA_OPS_SERVER_KEEP_DAYS=

# ---------- Mac 侧验证副本 ----------
# Mac 本地备份根目录（验证副本 + 变更门禁专用）。
MULTICA_OPS_MAC_BACKUP_ROOT=
# Mac 备份保留份数。
MULTICA_OPS_MAC_RETAIN=

# ---------- NAS 归档（Mac 挂载） ----------
# NAS 备份归档目录（长期归档副本）。
MULTICA_OPS_NAS_DIR=
# NAS 备份保留份数。
MULTICA_OPS_NAS_RETAIN=

# ---------- 巡检（patrol.sh 扩展键，Mac 侧） ----------
# Mac 本地巡检日志目录。
MULTICA_OPS_PATROL_LOG_DIR=
# NAS 巡检状态目录（心跳/告警文件）。
MULTICA_OPS_PATROL_NAS_STATE_DIR=
# 健康探测 URL：外网视角（业务视图）与站内视角（SSH 到服务器本机探测）。
MULTICA_OPS_BACKEND_URL_EXT=
MULTICA_OPS_BACKEND_URL_IN=
MULTICA_OPS_FRONTEND_URL_EXT=
MULTICA_OPS_FRONTEND_URL_IN=

# ---------- WireGuard 运维隧道（入口切换阶段启用） ----------
# 隧道接口名。
MULTICA_OPS_WG_IFACE=
# 服务器公网 UDP 隧道端口（安全组仅保留该端口用于运维入口）。
MULTICA_OPS_WG_PORT=
# 服务器公网 endpoint（供 Mac 客户端配置使用）。
MULTICA_OPS_WG_ENDPOINT=
# 隧道内地址：服务器侧 / Mac 客户端侧。
MULTICA_OPS_WG_SERVER_ADDR=
MULTICA_OPS_WG_CLIENT_ADDR=
# 密钥文件目录（仅路径；私钥文件本身绝不进 ops.env/仓库/NAS/备份包）。
MULTICA_OPS_WG_KEY_DIR_MAC=
MULTICA_OPS_WG_KEY_DIR_SERVER=
