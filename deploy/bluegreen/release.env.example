# Public release metadata only. Put secrets in MULTICA_RELEASE_ENV_FILE, never here.
BLUE_BACKEND_IMAGE=ghcr.io/example/multica-backend@sha256:replace
BLUE_WEB_IMAGE=ghcr.io/example/multica-web@sha256:replace
GREEN_BACKEND_IMAGE=ghcr.io/example/multica-backend@sha256:replace
GREEN_WEB_IMAGE=ghcr.io/example/multica-web@sha256:replace
MIGRATOR_IMAGE=ghcr.io/example/multica-backend@sha256:replace
BLUE_GENERATION=1
GREEN_GENERATION=2
BLUE_WORKER_OWNER=blue-worker-PER-376
GREEN_WORKER_OWNER=green-worker-PER-376
MULTICA_UPLOADS_VOLUME=multica_backend_uploads
MULTICA_STATE_NETWORK=multica_default
MULTICA_RELEASE_ENV_FILE=/etc/multica/release-secrets.env
RELEASE_ARTIFACT_DIR=/root-only/path/PER-376
