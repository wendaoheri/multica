# Managed PER-376 blue upstream fragment. Keep the public site/TLS policy in
# the host Caddyfile and import this file from that site block.
@api path /api/* /auth/* /ws* /health /healthz /readyz
handle @api {
	reverse_proxy 127.0.0.1:8080 {
		health_uri /readyz
		health_interval 5s
		health_timeout 2s
		health_passes 2
		health_fails 2
		fail_duration 30s
		max_fails 2
		flush_interval -1
		stream_close_delay 5m
		stream_timeout 24h
	}
}
handle {
	reverse_proxy 127.0.0.1:3000
}
